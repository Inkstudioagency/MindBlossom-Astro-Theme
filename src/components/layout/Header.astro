---
/**
 * Site header: announcement bar, navigation (dropdowns, mega menu with video) and mobile menu.
 * Markup, classes and data attributes follow the template so webflow.js (public/js) keeps
 * driving the dropdowns, the mobile menu and the interactions.
 */
import config from '@/config/config.json';
import { currentLink } from '@/lib/webflow';

interface Props {
  /** "v2" (light, used on most pages) or "base" (transparent, over a hero image or video) */
  variant?: 'v2' | 'base';
  /** Webflow component instance id of the navbar on this page (the interactions target it) */
  instance: string;
}

const { variant = 'v2', instance } = Astro.props;
const { site, announcement } = config;
const NAVBAR_V2 = '923cd88a-a517-b334-be39-55edc44459ee';
const variantState = variant === 'v2' ? NAVBAR_V2 : 'base';
const variantClass = variant === 'v2' ? ` w-variant-${NAVBAR_V2}` : '';
const target = (component: string, element: string) => JSON.stringify([[[component, element], [instance]]]);
const link = (href: string, className: string) => currentLink(href, Astro.url.pathname, className);
---

<div data-wf--navbar--variant={variant} data-wf-component-id="3c0ba350-4b9b-768d-3888-b4fbe366daea" data-wf-variant-state={variantState} class="nav-wrapper">
  <div class="nav-top">
    <div class="nav-top-item-wrap nav-top-center">
      <div class="nav-top-text deep-saffron">{announcement.label}</div>
      <div class="nav-devider-dot nav-top-dot"></div>
      <div class="nav-top-text">{announcement.text}</div>
      <div class="nav-devider-dot nav-top-dot"></div>
      <a {...link(announcement.button.link, 'nav-top-button w-inline-block')}>
        <div>{announcement.button.label}</div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 14 14" fill="none" class="nav-button-top-arrow">
          <path d="M2.91699 7H11.0837M7.58366 10.5L11.0837 7L7.58366 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
  <div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class={`navbar${variantClass} w-nav`}>
    <div class="container nav-container w-container">
      <div class={`nav-item-wrap${variantClass} nav-item-anchor`}>
        <a {...link('/', 'w-nav-brand')}><img sizes="(max-width: 767px) 98vw, (max-width: 991px) 95vw, 940px" srcset={site.logo_srcset} alt={site.logo_alt} src={site.logo} loading="lazy" class="brand-logo nav-logo"></a>
        <nav role="navigation" class={`nav-menu${variantClass} w-nav-menu`}>
          <div class="navlink-wrap nav-link-list">
