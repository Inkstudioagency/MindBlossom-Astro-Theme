      <path d="M17.375 6.75H17.25M17.5 6.75C17.5 6.88808 17.388 7 17.25 7C17.1119 7 17 6.88808 17 6.75C17 6.61193 17.1119 6.5 17.25 6.5C17.388 6.5 17.5 6.61193 17.5 6.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </>
