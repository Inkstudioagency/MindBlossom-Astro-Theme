---
/**
 * Program list with pagination. The pages are generated by src/pages/programs/index.astro
 * and src/pages/programs/page/[page].astro (page size: "programs_per_page" in config.json).
 */
import type { Page } from 'astro';
import ProgramCard from '@/components/cards/ProgramCard.astro';
import EmptyState from '@/components/cards/EmptyState.astro';
import type { Program } from '@/lib/content';

interface Props {
  page: Page<Program>;
}

const { page } = Astro.props;
import PrimaryButton from '@/components/ui/PrimaryButton.astro';
---

<section class="section programs-list-section">
  <div class="section-gap">
    <div class="container">
      <div class="work-list-wrap">
        <div class="section-header program work-list-header"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 335 282" fill="none" aria-hidden="true" scroll-rotate="" class="programs-list-flower">
            <path fill="currentColor" d="M333.3 161.1C325.7 189.9 292.3 202.4 265.2 201.5C249.6 201.1 235.3 196.4 221.2 190C218.5 188.8 215.8 187.5 213.1 186.1C213.3 187.3 213.5 188.5 213.6 189.7C215.3 202.5 216 214.8 214.1 227.6C210.1 254.6 192 284.8 160.9 281.7C134.3 279.2 113.8 251.5 107.2 227.4C104.9 219 104.2 210.6 104.6 202.2C63.5 219 13.5 229.2 1.6 185.9C-6.8 155.4 19.7 129.2 45.5 119.1C56 115 66.7 113.1 77.8 111.8C76.6 111 75.5 110.2 74.6 109.4C64 100.7 55.8 89.7 50.9 76.8C40.7 49.9 49.8 19.8 76.3 6.8C115.2-12.1 146 11.2 169.3 41.9C171.5 39.4 173.9 37 176.4 34.8C194.7 19.1 221.7 12.6 243.6 25.8C266.4 39.5 273.6 68.7 260.3 91.7C258.1 95.4 255.6 98.7 252.8 101.7C262.9 101.2 273 100.6 282.9 101.5C313 103.9 341.9 128.2 333.2 161.1L333.3 161.1Z"></path>
          </svg>
          <h2 heading-rebuild="" class="section-heading programs-list-title">Events made for little ones and their families</h2>
          <p to-top-2="" class="paragraph-regular work-list-text">Play days, art workshops, garden mornings, and storytime sessions that turn everyday moments into learning adventures.</p><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 57.1 68.7" fill="none" aria-hidden="true" class="programs-list-rings">
            <path fill="currentColor" transform="translate(2.02 36.43)" d="M25.9 29.2C18.1 35.1 6.2 32 1.7 23.5C-2.1 16.3 0.8 7.6 7.1 3.3C12.9-1.7 22.4-0.8 28 4.4C35.2 11.2 33.5 23.4 25.9 29.2ZM23.3 9.1C19.4 5.5 13.8 5.9 9.9 9.1C9.3 9.5 8.6 9.7 7.9 9.7C5.9 12.9 5.2 16.8 7 20.3C9.8 25.5 17.6 27.7 22.2 23.8C26.5 20.3 27.6 13 23.3 9.1L23.3 9.1Z"></path>
            <path fill="currentColor" transform="translate(0 4.16)" d="M12.6 22.2C5.5 22.1-1.4 15.2 0.2 7.9C1.1 4.2 4.3 1.4 7.8 0.6C13.9-1.5 21.4 2 23.1 8.4C24.9 15.2 19.8 22.3 12.6 22.2L12.6 22.2ZM17.3 9C15.6 5.4 11.4 5.3 8 5.7C7.7 5.7 7.4 5.7 7.2 5.6C6.1 6.6 5.3 7.9 5.3 9.6C5.4 13.5 9.5 16.7 13.2 16.4C16.7 16.2 18.8 12.2 17.3 9L17.3 9Z"></path>
            <path fill="currentColor" transform="translate(32.16 0)" d="M19.5 20.9C13.3 23.7 2.8 22.2 0.4 14.8C-0.4 12.3 0 9.4 1.2 7.1C1.5 4.3 3.7 1.8 6.4 0.7C10.5-1 15 0.6 18.5 2.9C25.2 7.2 28.3 16.9 19.5 20.9L19.5 20.9ZM16.5 9.1C13.5 6.5 7.8 4.2 6.7 9.6C6.5 10.6 5.8 11.2 5 11.4C5 11.7 5 11.9 5.1 12.2C5.8 15.8 10.6 16.6 13.7 16.4C15.2 16.2 17.6 15.8 18.5 14.5C20 12.5 18.1 10.4 16.5 9.1L16.5 9.1Z"></path>
          </svg>
        </div>
        <div class="programs-list w-dyn-list">
          {page.data.length > 0 ? (
            <div role="list" class="programs-cards w-dyn-items">
              {page.data.map((program) => <ProgramCard program={program} />)}
            </div>
          ) : (
            <EmptyState />
          )}
          <div to-top-0="" role="navigation" aria-label="List" class="w-pagination-wrapper programs-pagination">
            {page.url.prev && (
              <a aria-label="Previous programs" href={page.url.prev} class="w-pagination-previous slider-button programs-page-button"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="slider-arrow">
                <path d="M5.498 12L18.998 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M10.998 18C10.998 18 4.99815 13.5811 4.99805 12C4.99805 10.4188 10.998 6 10.998 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></a>
            )}
            {page.url.next && (
              <a aria-label="Next programs" href={page.url.next} class="w-pagination-next slider-button programs-page-button"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="slider-arrow">
                <path d="M18.502 12L5.00195 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M13.002 18C13.002 18 19.0019 13.5811 19.002 12C19.002 10.4188 13.002 6 13.002 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
