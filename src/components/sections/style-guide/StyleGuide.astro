              <div class="style-title is-primary">Color Palette</div>
            </div>
            <div class="style-guide-content-right-block">
              <div class="color-content-block">
                <div class="color-single-block">
                  <div class="color-block black-color"></div>
                  <div class="color-info-block">
                    <div class="style-title text-weight-semi-bold is-primary">Primary Color</div>
                    <div class="color-code">#b84d2b</div>
                  </div>
                </div>
                <div class="color-single-block">
                  <div class="color-block white-color"></div>
                  <div class="color-info-block">
                    <div class="style-title text-weight-semi-bold is-primary">White Color</div>
                    <div class="color-code">#ffffff</div>
                  </div>
                </div>
                <div class="color-single-block">
                  <div class="color-block bg-color-1"></div>
                  <div class="color-info-block">
                    <div class="style-title text-weight-semi-bold is-primary">Background Color</div>
                    <div class="color-code">#fbf1ec</div>
                  </div>
                </div>
                <div class="color-single-block">
                  <div class="color-block primitive-color"></div>
                  <div class="color-info-block">
                    <div class="style-title text-weight-semi-bold is-primary">Dark Color</div>
                    <div class="color-code">#171310</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div to-top-2="" class="style-guide-single-content">
