                </svg></div>
              <div class="style-title is-primary">Typography</div>
            </div>
            <div class="style-guide-content-right-block">
              <div class="typography-content-block">
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <h1 class="utility-heading">Heading 1</h1>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Semi Bold • 4.5rem • 1 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <h2 class="utility-heading">Heading 2</h2>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Semi Bold • 4rem • 1.1 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <h3>Heading 3</h3>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Semi Bold • 3rem • 1.1 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <h4>Heading 4</h4>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Semi Bold • 2rem • 1.2 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <h5>Heading 5</h5>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Semi Bold • 1.5rem • 1.3 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <h6>Heading 6</h6>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Semi Bold • 1.25rem • 1.3 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <p class="font-extra-normal">Text Regular: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Normal • 1.125rem • 1.2 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <p class="font-regular style-guide-text">Font Regular: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Normal • 1rem • 1.2 Line Height</div>
                  </div>
                </div>
                <div class="typography-single-block">
                  <div class="typography-text-block">
                    <p class="font-small style-guide-text">Font Small: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                  </div>
                  <div class="typography-info-block">
                    <div class="paragraph-xsmall">Parkinsans • Normal • 0.875rem • 1.4 Line Height</div>
                  </div>
                </div>
              </div>
            </div>
