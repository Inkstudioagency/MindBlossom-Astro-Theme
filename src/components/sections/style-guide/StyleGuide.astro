---
import PrimaryButton from '@/components/ui/PrimaryButton.astro';
---

<section class="section">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container w-container">
      <div class="style-guide-wrapper">
        <div class="section-heading-block align-left">
          <div class="style-guide-title-block bottom-padding">
            <h1 title-animation="" class="utility-heading">Style Guide</h1>
          </div>
          <div to-top-2s="" class="section-summary-block top-space">
            <p class="utility-summary is-secondary">The colors, typography and components that shape the MindBlossom template.</p>
          </div>
        </div>
        <div class="style-guide-content-block">
          <div to-top-4s="" class="style-guide-single-content">
            <div class="style-guide-content-left-block">
              <div class="style-guide-content-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M13.5 7C13.7761 7 14 6.77614 14 6.5C14 6.22386 13.7761 6 13.5 6C13.2239 6 13 6.22386 13 6.5C13 6.77614 13.2239 7 13.5 7Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
