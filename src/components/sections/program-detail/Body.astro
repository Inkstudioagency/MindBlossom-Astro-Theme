---
import RichText from '@/components/RichText.astro';
import { formatDate, type Program } from '@/lib/content';
import PrimaryButton from '@/components/ui/PrimaryButton.astro';
interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<section class="section program-detail-body">
  <div class="program-detail-layout">
    <div class="program-detail-article-wrap">
      <div class="program-detail-article">
        <RichText class="program-detail-rich-text" blocks={program.content} imageAlign="fullwidth" />
        <div to-top-0="" class="program-detail-schedule">
          <h2 class="font-large contact-title">Schedule</h2>
          <div class="program-detail-agenda">
            {program.schedule.map((item) => (
              <div class="program-detail-agenda-row">
                <div class="program-detail-agenda-time">{item.time}</div>
                <div class="program-detail-agenda-text">{item.activity}</div>
              </div>
            ))}
          </div>
        </div>
        <RichText class="program-detail-rich-text" blocks={program.details} imageAlign="normal" />
      </div>
    </div>
    <div class="program-detail-card">
      <div class="program-detail-card-head">
        <h2 class="font-large contact-title work-detail-card-title">{program.name}</h2>
        <div class="impact-tag program-detail-tag">
          <div class="font-extra-small work-detail-tag-text">{program.tag}</div>
        </div>
      </div>
      <div class="impact-meta program-detail-card-meta">
        <div class="impact-meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="program-detail-icon">
            <path d="M10.0003 18.3307C14.6027 18.3307 18.3337 14.5998 18.3337 9.9974C18.3337 5.39502 14.6027 1.66406 10.0003 1.66406C5.39795 1.66406 1.66699 5.39502 1.66699 9.9974C1.66699 14.5998 5.39795 18.3307 10.0003 18.3307Z" stroke="currentColor" stroke-width="1.25"></path>
            <path d="M10 6.66406V9.9974L11.6667 11.6641" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <div class="program-detail-card-date">
            <div class="paragraph-regular program-detail-card-text">{formatDate(program.date)}</div>
            <div class="paragraph-regular program-detail-card-text">{program.time}</div>
          </div>
        </div>
        <div class="impact-meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="program-detail-icon">
            <path d="M12.9163 9.16667C12.9163 10.7775 11.6105 12.0833 9.99967 12.0833C8.38884 12.0833 7.08301 10.7775 7.08301 9.16667C7.08301 7.55583 8.38884 6.25 9.99967 6.25C11.6105 6.25 12.9163 7.55583 12.9163 9.16667Z" stroke="currentColor" stroke-width="1.25"></path>
            <path d="M10 1.66406C14.0588 1.66406 17.5 5.02488 17.5 9.10223C17.5 13.2445 14.0027 16.1513 10.7725 18.128C10.5371 18.2609 10.2708 18.3307 10 18.3307C9.72917 18.3307 9.46292 18.2609 9.2275 18.128C6.00325 16.1321 2.5 13.2588 2.5 9.10223C2.5 5.02488 5.9412 1.66406 10 1.66406Z" stroke="currentColor" stroke-width="1.25"></path>
          </svg>
          <div class="paragraph-regular program-detail-card-text">{program.location}</div>
        </div>
      </div>
      <div aria-hidden="true" class="program-detail-card-line program-detail-card-dash"></div>
      <div class="impact-card-footer program-detail-footer">
        <p class="paragraph-regular stories">{program.availability}</p>
        <PrimaryButton href="/contact-us" label="Register Now" />
      </div>
    </div>
  </div>
</section>
