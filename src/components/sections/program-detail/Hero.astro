---
import { formatDate, type Program } from '@/lib/content';

interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<section class="section home-hero">
  <div class="container">
    <div class="home-hero-content-block">
      <div data-wf-target="[[[&quot;6acfe24ca1d63e5669f2df32&quot;,&quot;62ab69fa-5d6c-4a50-0868-a776b7ed3908&quot;],[]]]" class="program-detail-date">
        <div class="program-detail-date-text">{formatDate(program.date)}</div>
        <div class="program-detail-date-text">{program.time}</div>
      </div>
      <div class="heading-wrap">
        <h1 data-wf-target="[[[&quot;6acfe24ca1d63e5669f2df32&quot;,&quot;8eeffdae-25e1-a9f2-5f26-1425ad381f9b&quot;],[]]]" class="hero-heading center">{program.name}</h1>
      </div>
      <div data-wf-target="[[[&quot;6acfe24ca1d63e5669f2df32&quot;,&quot;71bc6de3-1c8e-1f03-b4ca-3291183aded7&quot;],[]]]" class="program-detail-venue">
        <div class="program-detail-venue-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="program-detail-icon">
            <path d="M12.9163 9.16667C12.9163 10.7775 11.6105 12.0833 9.99967 12.0833C8.38884 12.0833 7.08301 10.7775 7.08301 9.16667C7.08301 7.55583 8.38884 6.25 9.99967 6.25C11.6105 6.25 12.9163 7.55583 12.9163 9.16667Z" stroke="currentColor" stroke-width="1.25"></path>
            <path d="M10 1.66406C14.0588 1.66406 17.5 5.02488 17.5 9.10223C17.5 13.2445 14.0027 16.1513 10.7725 18.128C10.5371 18.2609 10.2708 18.3307 10 18.3307C9.72917 18.3307 9.46292 18.2609 9.2275 18.128C6.00325 16.1321 2.5 13.2588 2.5 9.10223C2.5 5.02488 5.9412 1.66406 10 1.66406Z" stroke="currentColor" stroke-width="1.25"></path>
          </svg></div>
        <div class="program-detail-venue-text">
          <div class="program-detail-label">Venue</div>
          <div class="program-detail-venue-value">{program.location}</div>
        </div>
      </div>
    </div>
  </div>
</section>
