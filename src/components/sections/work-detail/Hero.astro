---
import RichText from '@/components/RichText.astro';
import type { Work } from '@/lib/content';

interface Props {
  work: Work;
}

const { work } = Astro.props;
// Same order as the template: the first two stats, the program lead, then the third stat
const [first, second, third] = work.stats;
const stats = [
  first && { ...first, counter: true },
  second && { ...second, counter: true },
  work.programLead && { label: 'Program lead', value: work.programLead, counter: false },
  third && { ...third, counter: true },
].filter((stat): stat is { label: string; value: string; counter: boolean } => Boolean(stat));
---

<section class="section about-hero-section">
  <div class="section-gap programs-hero-gap">
    <div class="container">
      <div class="work-detail-wrap">
        <div class="about-hero-content"><svg data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;9d20a7cc-f782-580d-60f1-49437d5384c6&quot;],[]]]" xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 224 211" fill="none" aria-hidden="true" scroll-rotate="" class="stories-flower work-detail-flower">
            <path fill="currentColor" d="M70.2177 3.55552C94.822 -6.4476 122.878 5.38935 132.881 29.9937L138.03 42.6597L156.969 34.9599C181.573 24.9569 209.629 36.7931 219.632 61.3972C229.635 86.0015 217.798 114.057 193.194 124.06L174.255 131.76L179.402 144.42C189.405 169.024 177.568 197.079 152.963 207.082C128.359 217.085 100.305 205.249 90.3015 180.644L85.1546 167.985L66.2156 175.685C41.6113 185.688 13.5566 173.85 3.55344 149.246C-6.44941 124.642 5.3869 96.5872 29.991 86.5841L48.93 78.8843L43.7805 66.2183C33.7774 41.614 45.6135 13.5587 70.2177 3.55552Z"></path>
          </svg><img src="/images/Layer_1.webp" loading="lazy" data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;6d4ddb1d-83f8-6dc6-5c1d-a3bae174c3b7&quot;],[]]]" alt="Minimalist black hand making the OK gesture with three small brown rounded shapes around it on a white background." class="about-hero-sparkle work-detail-sparkle">
          <div data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;7111f0ed-ca17-af8a-6512-0f1a65262965&quot;],[]]]" class="work-detail-tags">
            <div class="impact-tag work-detail-tag">
              <div class="font-extra-small">{work.category}</div>
            </div>
            {work.focus && (
              <div class="impact-tag work-detail-tag work-detail-tag-outline">
                <div class="font-extra-small">{work.focus}</div>
              </div>
            )}
          </div>
          <div class="about-hero-text-wrap">
            <h1 data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;eb5a83fb-b998-bc2e-1a2f-4cce63259a05&quot;],[]]]" class="section-heading about-hero-title work-detail-title">{work.name}</h1>
            <p data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;51eaeab8-fd72-53ba-0fe3-2a048bf8df23&quot;],[]]]" class="paragraph-regular about-hero-text work-detail-text">{work.shortDescription}</p>
          </div>
          <div data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;d08c2096-b7c0-c002-fde7-4e3c57087f44&quot;],[]]]" class="work-detail-stats">
            {stats.map((stat, i) => (
              <>
                {i > 0 && <div class="work-detail-stat-line"></div>}
                <div class="work-detail-stat">
                  <p class="paragraph-regular work-card-text work-detail-stat-label">{stat.label}</p>
                  {stat.counter ? (
                    <div data-counter="counter" class="font-large contact-title work-detail-stat-value">{stat.value}</div>
                  ) : (
                    <div class="font-large contact-title work-detail-stat-value">{stat.value}</div>
                  )}
                </div>
              </>
            ))}
          </div>
        </div>
        <div data-wf-target="[[[&quot;6acfa7b7c0cf1a7e9f5af957&quot;,&quot;0d71eb9a-43e4-83b6-5b0f-7bd85fc0c4fc&quot;],[]]]" class="work-detail-media"><img src={work.image.url} loading="lazy" alt={work.image.alt} class="work-detail-image"></div>
        <RichText class="work-detail-rich-text" blocks={work.content} />
      </div>
    </div>
  </div>
</section>
