<section class="section about-hero-section">
  <div class="section-gap">
    <div class="container">
      <div class="faq-wrap">
        <div class="faq-header">
          <div to-top-0="" class="faq-eyebrow">
            <div class="faq-dot"></div>
            <div class="font-extra-small faq">Where to find us</div>
          </div>
          <div class="header-item-wrap">
            <div class="max-width-60">
              <h2 heading-rebuild="" class="section-heading center">Our centers</h2>
            </div>
            <div to-top-2="" class="max-width-42 contact-offices-text">
              <p class="paragraph-regular center">Two cosy centers in Brooklyn. Tours welcome by appointment.</p>
            </div>
          </div>
        </div>
        <div class="contact-office-list">
          <div to-top-0="" class="contact-office-row">
            <div class="contact-office-card">
              <div class="contact-office-top">
                <div class="contact-icon-box contact-icon-box-small"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="contact-icon">
                    <path d="M15.5 11C15.5 12.933 13.933 14.5 12 14.5C10.067 14.5 8.5 12.933 8.5 11C8.5 9.067 10.067 7.5 12 7.5C13.933 7.5 15.5 9.067 15.5 11Z" stroke="currentColor" stroke-width="1.5"></path>
                    <path d="M12 2C16.8706 2 21 6.03298 21 10.9258C21 15.8965 16.8033 19.3847 12.927 21.7567C12.6445 21.9162 12.325 22 12 22C11.675 22 11.3555 21.9162 11.073 21.7567C7.2039 19.3616 3 15.9137 3 10.9258C3 6.03298 7.12944 2 12 2Z" stroke="currentColor" stroke-width="1.5"></path>
                  </svg></div>
                <div class="contact-office-info">
                  <div class="font-large">Park Slope</div>
                  <div class="impact-meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="impact-meta-icon">
                      <path d="M10.0013 18.3307C14.6037 18.3307 18.3346 14.5998 18.3346 9.9974C18.3346 5.39502 14.6037 1.66406 10.0013 1.66406C5.39893 1.66406 1.66797 5.39502 1.66797 9.9974C1.66797 14.5998 5.39893 18.3307 10.0013 18.3307Z" stroke="currentColor" stroke-width="1.25"></path>
                      <path d="M10 6.66406V9.9974L11.6667 11.6641" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <p class="paragraph-regular contact-hours">Mon–Fri · 8:00–17:00</p>
                  </div>
                </div>
              </div>
              <p class="paragraph-regular feature contact-address">48 Meadow Lane, Brooklyn, NY 11215, USA</p>
            </div><img src="/images/Rectangle-28.webp" loading="lazy" sizes="100vw" srcset="/images/Rectangle-28-p-500.webp 500w, /images/Rectangle-28-p-800.webp 800w, /images/Rectangle-28-p-1080.webp 1080w, /images/Rectangle-28-p-1600.webp 1600w, /images/Rectangle-28.webp 1703w" alt="Portland office building" class="contact-office-image">
