---
import config from '@/config/config.json';
---

<section class="section about-hero-section">
  <div class="section-gap contact-hero-gap">
    <div class="container">
      <div class="about-hero-content"><svg data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;c7c096d2-7f36-ff5e-2ab8-e0d52b95c5aa&quot;],[]]]" xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 224 211" fill="none" aria-hidden="true" scroll-rotate="" class="stories-flower contact-flower">
          <path fill="currentColor" d="M70.2177 3.55552C94.822 -6.4476 122.878 5.38935 132.881 29.9937L138.03 42.6597L156.969 34.9599C181.573 24.9569 209.629 36.7931 219.632 61.3972C229.635 86.0015 217.798 114.057 193.194 124.06L174.255 131.76L179.402 144.42C189.405 169.024 177.568 197.079 152.963 207.082C128.359 217.085 100.305 205.249 90.3015 180.644L85.1546 167.985L66.2156 175.685C41.6113 185.688 13.5566 173.85 3.55344 149.246C-6.44941 124.642 5.3869 96.5872 29.991 86.5841L48.93 78.8843L43.7805 66.2183C33.7774 41.614 45.6135 13.5587 70.2177 3.55552Z"></path>
        </svg><img src="/images/Layer_1.webp" loading="lazy" data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;185936b8-4be4-f452-1667-dea985abe6ce&quot;],[]]]" alt="Minimalist black hand making the OK gesture with three small brown rounded shapes around it on a white background." class="about-hero-sparkle contact-sparkle">
        <div data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;7c66640a-829c-e866-1999-74fd2953d4f6&quot;],[]]]" class="about-hero-eyebrow"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="about-hero-eyebrow-icon">
            <path d="M17.126 14.582L20.4593 17.9154" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M7.51918 3.15938L10.3075 4.09919C10.6931 4.23264 11.2781 4.14538 11.6093 3.90939L13.5654 2.51439C14.8168 1.62286 15.8526 2.15458 15.8537 3.70005L15.8645 6.3163C15.8663 6.75937 16.1745 7.3092 16.5499 7.5481L18.5485 8.80111C20.1293 9.79403 19.9496 10.9694 18.1479 11.4262L15.6403 12.0594C15.1872 12.1736 14.7198 12.6411 14.6004 13.0995L13.9673 15.6076C13.5159 17.4044 12.3301 17.5841 11.3427 16.0082L10.0899 14.0093C9.85103 13.6338 9.30131 13.3256 8.85832 13.3238L6.24255 13.313C4.70263 13.3067 4.16575 12.2759 5.05712 11.0242L6.45185 9.06778C6.68255 8.74178 6.76979 8.15662 6.63637 7.77103L5.69673 4.98217C5.1895 3.46627 6.00882 2.64681 7.51918 3.15938Z" fill="currentColor" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <div class="font-extra-small faq">Contact Us</div>
        </div>
        <div class="about-hero-text-wrap">
          <h1 data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;bfd03a9c-fa41-db26-0cde-6bec88e5c265&quot;],[]]]" class="section-heading about-hero-title memories-hero-title">Say Hello. Contact &amp; Enrollment</h1>
          <p data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;aac4ad17-fc3e-b341-be2b-a33e561c809d&quot;],[]]]" class="paragraph-regular about-hero-text contact-hero-text">Questions about enrollment, a program, a tour or tuition — pick the channel that suits you. We answer within two working days.</p>
        </div>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="contact-stack">
      <div data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;7afde813-35b2-1acc-f7d9-58707dbc1600&quot;],[]]]" class="contact-card">
        <div class="font-large contact-title">Send a message</div>
        <div class="contact-form-block w-form">
          <form id="wf-form-Contact-Form" name="wf-form-Contact-Form" data-name="Contact Form" method="get" class="contact-form" data-wf-page-id="6ad07df6b9187a874bdd50da" data-wf-element-id="d775e76d-f75e-4cdb-e406-52e02dedff63">
            <div class="contact-field-row">
              <div class="contact-field"><label for="parent-name" class="contact-label">Parent’s Name</label><input class="contact-input w-input" maxlength="256" name="Parent-Name" data-name="Parent Name" placeholder="Jane Appleseed" type="text" id="parent-name" required=""></div>
              <div class="contact-field"><label for="contact-email" class="contact-label">Email</label><input class="contact-input w-input" maxlength="256" name="email" data-name="Email" placeholder="you@email.com" type="email" id="contact-email" required=""></div>
            </div>
            <div class="contact-field-row">
              <div class="contact-field"><label for="child-name" class="contact-label">Child’s Name</label><input class="contact-input w-input" maxlength="256" name="Child-Name" data-name="Child Name" placeholder="Jane Appleseed" type="text" id="child-name"></div>
              <div class="contact-field"><label for="child-age" class="contact-label">Child’s Age</label><input class="contact-input w-input" maxlength="256" name="Child-Age" data-name="Child Age" placeholder="2 years 4 months  " type="text" id="child-age"></div>
            </div>
            <div class="contact-field"><label for="" class="contact-label">What is this about?</label>
              <div class="contact-select-wrap"><select id="topic" name="Topic" data-name="Topic" class="contact-input contact-select w-select">
                  <option value="">Choose a topic</option>
                  <option value="First">First choice</option>
                  <option value="Second">Second choice</option>
                  <option value="Third">Third choice</option>
                </select><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="contact-select-icon">
                  <path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
            <div class="contact-field"><label for="message" class="contact-label">Message</label><textarea placeholder="How can we help?" maxlength="5000" id="message" name="Message" data-name="Message" class="contact-input contact-textarea w-input"></textarea></div><label class="w-checkbox contact-checkbox-field"><input type="checkbox" id="monthly-update" name="Monthly-Update" data-name="Monthly Update" class="w-checkbox-input contact-checkbox"><span class="contact-checkbox-label w-form-label">Send me the monthly family newsletter (one email, no noise).</span></label><input type="submit" data-wait="Sending..." class="contact-submit w-button" value="Send message">
            <div class="contact-note-row">
              <div class="font-extra-small contact-note">We use your details only to reply. Read our</div>
              <a href={config.contact.privacy_policy_url} class="font-extra-small contact-note-link">privacy notice.</a>
            </div>
          </form>
          <div class="success-message w-form-done">
            <div>Thank you! We will reply within two working days.</div>
          </div>
          <div class="error-message w-form-fail">
            <div>Oops! Something went wrong while submitting the form.</div>
          </div>
        </div>
      </div>
      <div class="contact-info-grid">
        <div data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;fe8bb04d-d736-5703-3981-bb6ed353fccb&quot;],[]]]" class="contact-card contact-info-card">
          <div class="contact-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="contact-icon">
              <path d="M9.15826 5.71223L8.7556 4.80625C8.49232 4.21388 8.36068 3.91768 8.16381 3.69101C7.91708 3.40694 7.59547 3.19794 7.23568 3.08785C6.94859 3 6.62446 3 5.97621 3C5.02791 3 4.55376 3 4.15573 3.18229C3.68687 3.39702 3.26344 3.86328 3.09473 4.3506C2.95151 4.76429 2.99254 5.18943 3.07458 6.0397C3.94791 15.0902 8.90982 20.0521 17.9603 20.9255C18.8106 21.0075 19.2358 21.0485 19.6494 20.9053C20.1368 20.7366 20.603 20.3132 20.8178 19.8443C21 19.4463 21 18.9721 21 18.0238C21 17.3756 21 17.0515 20.9122 16.7644C20.8021 16.4046 20.5931 16.083 20.309 15.8362C20.0824 15.6394 19.7862 15.5077 19.1938 15.2444L18.2878 14.8418C17.6463 14.5567 17.3255 14.4141 16.9996 14.3831C16.6876 14.3534 16.3731 14.3972 16.0811 14.5109C15.776 14.6297 15.5064 14.8544 14.967 15.3039C14.4302 15.7512 14.1618 15.9749 13.8338 16.0947C13.543 16.201 13.1586 16.2403 12.8524 16.1952C12.5069 16.1443 12.2424 16.0029 11.7133 15.7202C10.0673 14.8405 9.15953 13.9328 8.27987 12.2868C7.99714 11.7577 7.85578 11.4932 7.80487 11.1477C7.75974 10.8415 7.79908 10.4571 7.9053 10.1663C8.02512 9.83828 8.24881 9.56986 8.69619 9.033C9.14562 8.49368 9.37034 8.22402 9.48915 7.91891C9.60285 7.62694 9.64662 7.3124 9.61695 7.00048C9.58594 6.67452 9.44338 6.35376 9.15826 5.71223Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg></div>
          <div class="contact-info-text">
            <p class="mission-feature-title contact-info-title">Want to talk?</p>
            <div class="contact-note-row">
              <div class="font-extra-small contact-note">Call directly:</div>
              <a href="tel:+12122588996369" class="font-extra-small contact-note-link">(+12 122588996369)</a>
            </div>
          </div>
        </div>
        <div data-wf-target="[[[&quot;6ad07df6b9187a874bdd50da&quot;,&quot;3dc75d81-6a01-570d-de24-9fe96a05e7a1&quot;],[]]]" class="contact-card contact-info-card">
          <div class="contact-icon-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="contact-icon">
              <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor" stroke-width="1.5"></path>
              <path d="M12 8V12L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg></div>
          <div class="contact-info-text contact-info-text-hours">
            <div class="font-extra-small contact-note">Opening Hours</div>
            <p class="mission-feature-title contact-hours-title">Monday–Friday: 8:00 AM – 5:00 PM</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
